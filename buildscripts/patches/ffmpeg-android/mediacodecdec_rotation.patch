avcodec/mediacodecdec: add a rotation option

MediaCodec rotates what it renders to a surface when it is configured with
MediaFormat.KEY_ROTATION ("rotation-degrees", API 21, clockwise, 0/90/180/
270). The decoder builds the MediaFormat itself and gave a caller no way to
set it, so a caller that shows the surface directly (mpv's
vo=mediacodec_embed/mediacodec_osd) could not show a video rotated by its
container's display matrix upright: nothing downstream sees the pixels. The
option is the caller's, as the rotation is: without a surface it has no
effect.

plynic (Android only): plynic-mpv's vd_lavc sets it for the MediaCodec VOs.

diff --git a/libavcodec/mediacodecdec.c b/libavcodec/mediacodecdec.c
--- a/libavcodec/mediacodecdec.c
+++ b/libavcodec/mediacodecdec.c
@@ -59,6 +59,8 @@
     int use_ndk_codec;
     // Ref. MediaFormat KEY_OPERATING_RATE
     int operating_rate;
+    // Ref. MediaFormat KEY_ROTATION
+    int rotation;
 } MediaCodecH264DecContext;
 
 static av_cold int mediacodec_decode_close(AVCodecContext *avctx)
@@ -440,6 +442,15 @@
     }
     if (s->operating_rate > 0)
         ff_AMediaFormat_setInt32(format, "operating-rate", s->operating_rate);
+    if (s->rotation) {
+        if (s->rotation % 90) {
+            av_log(avctx, AV_LOG_ERROR, "Unsupported rotation %d, must be 0, 90, 180 or 270\n",
+                   s->rotation);
+            ret = AVERROR(EINVAL);
+            goto done;
+        }
+        ff_AMediaFormat_setInt32(format, "rotation-degrees", s->rotation);
+    }
 
     s->ctx = av_mallocz(sizeof(*s->ctx));
     if (!s->ctx) {
@@ -600,6 +611,8 @@
                    OFFSET(use_ndk_codec), AV_OPT_TYPE_BOOL, {.i64 = -1}, -1, 1, VD },
     { "operating_rate", "The desired operating rate that the codec will need to operate at, zero for unspecified",
             OFFSET(operating_rate), AV_OPT_TYPE_INT, {.i64 = 0}, 0, INT_MAX, VD },
+    { "rotation", "Clockwise rotation in degrees (0, 90, 180 or 270) the codec applies to the frames it renders to a surface",
+            OFFSET(rotation), AV_OPT_TYPE_INT, {.i64 = 0}, 0, 270, VD },
     { NULL }
 };
 
